# Alpaca paper trading. Copy to .env and fill in.
# Dashboard -> select PAPER account (top-left) -> API Keys -> Generate New Key.
# The secret is displayed once; regenerating invalidates the previous pair.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Contact address sent to SEC EDGAR (their fair-access policy requires one).
SEC_CONTACT=Cascade Research gbangbolaphilip@gmail.com

# xAI Grok — two-stage LLM (triage + edge adjudication)
XAI_API_KEY=
GROK_TRIAGE_MODEL=grok-4.1-fast
GROK_ADJUDICATOR_MODEL=grok-4.6
