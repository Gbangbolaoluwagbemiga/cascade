# ─────────────────────────────────────────────────────────────────────────────
# Cascade — configuration
#
# One process serves the web UI, the API and the agent. There is no separate
# frontend build, so this is the whole surface.
#
# REQUIRED marks what the deploy will not start usefully without.
# ─────────────────────────────────────────────────────────────────────────────

# ── Alpaca — REQUIRED ────────────────────────────────────────────────────────
# app.alpaca.markets → select the PAPER account (top left) → API Keys → Generate.
# Paper accounts need only an email; MFA must be on before keys are shown.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Paper endpoints. Change only to trade live, which this project is not built for.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ── SEC — REQUIRED ───────────────────────────────────────────────────────────
# EDGAR's fair-access policy requires a contact address on every request.
# Any address you own. Requests without one are refused.
SEC_CONTACT=Your Name your@email.com

# ── LLM — REQUIRED for triage and edge adjudication ──────────────────────────
# Set ONE. Two different companies with similar names:
#   Groq — inference provider (Llama, Qwen, gpt-oss) at api.groq.com
#   Grok — xAI's own model at api.x.ai
# Without either, triage falls back to a deterministic classifier and the agent
# reports that it is unpowered rather than implying a judgement.
GROQ_API_KEY=
# XAI_API_KEY=

# Optional. Left unset, the best available model is chosen from the provider's
# live /models list — model IDs get retired, and a hardcoded default fails on
# the first real call rather than at startup.
# TRIAGE_MODEL=openai/gpt-oss-20b
# ADJUDICATOR_MODEL=openai/gpt-oss-120b

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=8787                 # Railway overrides this
RUN_DAEMON=true           # run the agent inside the web process
AUTO_TRADE=false          # true to submit real paper orders; default is dry run
POLL_MS=180000            # how often the agent scans for events
MAX_CASCADES=2            # cascades acted on per cycle

# ── Risk ─────────────────────────────────────────────────────────────────────
PORTFOLIO_CAP=0.60        # ceiling on capital deployed across the whole book
START_EQUITY=100000       # baseline for the realised/unrealised split

# Close every position at a wall-clock time, turning a floating book into a
# realised number. Unset to disable.
FLATTEN_AT=2026-09-04T13:50:00Z

# ── Telegram — optional ──────────────────────────────────────────────────────
# @BotFather for a token; message the bot once, then read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Advanced ─────────────────────────────────────────────────────────────────
# EXECUTION_VIA=rest      # bypass Alpaca's MCP server and use REST directly
# GROQ_BASE_URL=          # override the provider endpoint
# XAI_BASE_URL=
