# Alpaca paper trading. Copy to .env and fill in.
# Dashboard -> select PAPER account (top-left) -> API Keys -> Generate New Key.
# The secret is displayed once; regenerating invalidates the previous pair.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Contact address sent to SEC EDGAR (their fair-access policy requires one).
SEC_CONTACT=Cascade Research gbangbolaphilip@gmail.com

# Two-stage LLM: cheap triage on every headline, capable adjudication per edge.
# Set ONE of these. They are different companies with similar names:
#   Groq — inference provider (Llama, Qwen, gpt-oss) at api.groq.com
#   Grok — xAI's own model at api.x.ai
GROQ_API_KEY=
# XAI_API_KEY=
#
# Optional overrides. Left unset, the best available model is chosen from the
# provider's live /models list — model IDs get retired, so a hardcoded default
# would fail on the first real call.
# TRIAGE_MODEL=openai/gpt-oss-20b
# ADJUDICATOR_MODEL=openai/gpt-oss-120b

# Telegram feed — optional. Create a bot with @BotFather, then message it and
# read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Close every position at this wall-clock time, converting a floating book into
# a realised number before a deadline. Submission is 2026-09-04 16:00 WAT; this
# fires 20 minutes after the US open that morning, leaving ~70 minutes of slack.
FLATTEN_AT=2026-09-04T13:50:00Z
